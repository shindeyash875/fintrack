# App Environment
ENVIRONMENT=development
DEBUG=true
APP_VERSION=1.0.0

# Database Configuration (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintrack
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: Direct database URL override (e.g. for hosted cloud databases)
# If set, DATABASE_URL takes precedence over individual DB_* parameters.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fintrack

# Test Database Name
TEST_DB_NAME=fintrack_test

# JWT Authentication & Token Lifecycles
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
RESET_TOKEN_EXPIRE_MINUTES=60
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Google OAuth 2.0 / OpenID Connect (Optional for local dev, required for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Cookie Security (Set COOKIE_SECURE=true in HTTPS production environments)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# =========================================================================
# Email & SMTP Configuration (Works with Gmail SMTP, Resend, SendGrid, etc.)
# =========================================================================
# Option A: Gmail SMTP (Ideal for local testing with Google App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_character_google_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com
# SMTP_FROM_NAME=FinTrack
# SMTP_STARTTLS=true
# SMTP_SSL=false

# Option B: Resend SMTP (Ideal for production or testing with Resend API Key)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=FinTrack
SMTP_STARTTLS=true
SMTP_SSL=false

# Frontend URL (Used for generating email verification and password reset links)
FRONTEND_URL=http://localhost:5173

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://fintrack.vercel.app

# Starter Category Seeding (true to seed Food, Transport, Rent, etc. globally)
SEED_STARTER_CATEGORIES=false

# =========================================================================
# Universal AI Engine Configuration (Google Gemini / OpenAI / Anthropic Claude)
# =========================================================================
# Active Provider: "gemini" | "openai" | "claude"
AI_PROVIDER=gemini

# Model override (Optional: defaults to gemini-3.6-flash / gpt-4o-mini / claude-3-5-haiku-20241022)
# AI_MODEL=gemini-3.6-flash

# Universal API Key for the active provider (or set provider-specific keys below)
AI_API_KEY=your_ai_api_key_here

# Provider-specific keys (Optional alternative to AI_API_KEY)
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

