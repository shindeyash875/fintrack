{
  "info": {
    "name": "FinTrack API Collection",
    "_postman_id": "fintrack-api-v1-collection",
    "description": "Comprehensive Postman collection for manual and automated testing of the FinTrack FastAPI backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "Platform Root Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Platform-level health check probe for Render/Docker verifying process liveness and DB connection."
          }
        },
        {
          "name": "API v1 Deep Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Validates API v1 router mounting and executes an active SELECT 1 query on PostgreSQL."
          }
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "List All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "Retrieves all categories along with live expense_count."
          }
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.id) {",
                  "        pm.environment.set('category_id', res.data.id);",
                  "        console.log('Saved category_id:', res.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Groceries\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "Creates a new category. Automatically normalized to Title Case."
          }
        },
        {
          "name": "Rename Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Food & Groceries\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/categories/{{category_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{category_id}}"
              ]
            },
            "description": "Renames an existing category by UUID."
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/categories/{{category_id}}?cascade=false",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{category_id}}"
              ],
              "query": [
                {
                  "key": "cascade",
                  "value": "false"
                },
                {
                  "key": "reassign_to",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "Deletes category if not in use, or with optional cascade/reassign."
          }
        }
      ]
    },
