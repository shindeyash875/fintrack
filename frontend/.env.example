# FinTrack Frontend Environment Variables
# -------------------------------------------------------------
# Local Development:
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# Deployed Production (e.g. on Vercel):
# Set this in Vercel Project Settings > Environment Variables:
# VITE_API_BASE_URL=https://<your-backend-service>.onrender.com/api/v1
# Note: VITE_API_URL and VITE_BACKEND_URL are also accepted as aliases.
# The application automatically appends /api/v1 and enforces HTTPS.
